# 项目根目录环境变量示例。
# Docker/整项目部署时复制为项目根目录 .env 使用；docker-compose.yml 会通过 env_file 加载它。
# 不要提交真实 .env 文件。后端本地开发也可以参考 backend/.env.example。
# 结构化合同比对必配：PPOCRV5_URL 和 PPSTRUCTURE_URL。


# ---------------------------------------------------------------------------
# 后端服务运行
# ---------------------------------------------------------------------------

# 后端监听地址。Docker Compose 会覆盖为 0.0.0.0，普通本地运行可用 127.0.0.1。
HOST=127.0.0.1

# 后端监听端口。
PORT=8000

# 是否开启开发热重载。生产环境建议 false。
RELOAD=false

# 前端开发服务器跨域白名单。多个地址用英文逗号分隔。
FRONTEND_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 认证模式：oidc（默认、安全）或 disabled（仅限本地开发/可信内网）。
# 前后端模式必须保持一致。disabled 模式下所有请求共享一个固定身份。
AUTH_MODE=oidc
AUTH_DISABLED_USER_SUB=local-dev
AUTH_DISABLED_USER_NAME=本地开发用户
AUTH_DISABLED_USER_ROLES=agent_admin,agent_manager,agent_user

# Keycloak / OIDC resource-server validation. This backend does not use a client secret.
OIDC_DISCOVERY_URL=http://10.8.6.32:18080/realms/company-dev/.well-known/openid-configuration
OIDC_ISSUER=http://10.8.6.32:18080/realms/company-dev
OIDC_AUDIENCE=rixin-contract-comparison-api
OIDC_RESOURCE_CLIENT_ID=rixin-contract-comparison-api
OIDC_ALLOWED_ALGORITHMS=RS256


# ---------------------------------------------------------------------------
# Docker 端口绑定
# ---------------------------------------------------------------------------

# 外层 Nginx 作为唯一公网入口时，只把前端容器端口绑定到 127.0.0.1。
# 后端只在 Docker 内部网络暴露，由前端容器 Nginx 代理 /api/ 到 backend:8000。
FRONTEND_BIND_ADDR=127.0.0.1
FRONTEND_HOST_PORT=18080


# ---------------------------------------------------------------------------
# 前端构建与统一入口路径
# ---------------------------------------------------------------------------

# 前端部署在域名根路径时留空；通过外层 Nginx 挂到 /contract 时设置为 /contract。
VITE_BASE_PATH=/contract

# 浏览器可见的 API 前缀。通常留空，默认使用 VITE_BASE_PATH + /api。
# 例如 VITE_BASE_PATH=/contract 时，浏览器请求 /contract/api。
VITE_API_BASE_PATH=

# 可选。仅本地开发需要绕过 Nginx 直连后端时填写，例如 http://127.0.0.1:8000。
# Nginx 部署时保持为空，避免浏览器请求绕过统一入口。
VITE_API_BASE_URL=

# Docker callback/logout/origin values must be registered with the authentication administrator first.
VITE_AUTH_MODE=oidc
VITE_AUTH_DISABLED_USER_SUB=local-dev
VITE_AUTH_DISABLED_USER_NAME=本地开发用户
VITE_AUTH_DISABLED_USER_ROLES=agent_admin,agent_manager,agent_user
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=
VITE_OIDC_SCOPE=


# ---------------------------------------------------------------------------
# 存储与上传
# ---------------------------------------------------------------------------

# 运行时存储根目录。Docker Compose 会覆盖为 /data/storage。
STORAGE_DIR=storage

# PDF 上传大小上限，单位 MB。
MAX_UPLOAD_SIZE_MB=30


# ---------------------------------------------------------------------------
# 结构化抽取
# ---------------------------------------------------------------------------

# 推荐的合同比对抽取器：合并 PP-Structure 版面结果和 PP-OCRV5 文本结果。
COMPARE_DOCUMENT_EXTRACTOR=ppstructure_ocr_hybrid

# 生产环境建议保持 true；结构化 OCR 不可用时直接失败，避免退化为低质量比对。
COMPARE_REQUIRE_STRUCTURED_OCR=true

# P1 灰度开关。仅在 OCR 服务两路并发压测通过后开启。
COMPARE_PARALLEL_EXTRACTION_ENABLED=false

# 单个 API 进程同时执行的文档解析数，避免多个后台任务把 OCR 服务并发放大。
COMPARE_PARALLEL_EXTRACTION_MAX_INFLIGHT=2

# 页脚视觉差异识别的页面级最大并发数；结果仍按页码顺序合并。
COMPARE_FOOTER_VISUAL_MAX_INFLIGHT=4

# P2 严格原生 PDF 快速路径：off、shadow 或 enabled。建议先使用 shadow 观察命中率。
COMPARE_NATIVE_FAST_PATH_MODE=off

# 每页最少可复制字符数，以及字符坐标和异常编码门禁。
COMPARE_NATIVE_FAST_PATH_MIN_CHARS_PER_PAGE=80
COMPARE_NATIVE_FAST_PATH_MIN_CHAR_BOX_COVERAGE=0.98
COMPARE_NATIVE_FAST_PATH_MAX_SUSPICIOUS_CHAR_RATIO=0.01

# 使用 v3 版面流角色，用于识别正文、页眉页脚、表格、噪声等区域。
LAYOUT_ANALYSIS_MODE=v3


# ---------------------------------------------------------------------------
# PP-OCRV5 文本识别
# ---------------------------------------------------------------------------

# 必填。PP-OCRV5 服务 HTTP 地址。
PPOCRV5_URL=http://10.8.7.76:8080/

# 可选。OCR 服务需要鉴权时填写访问 token。
PPOCRV5_ACCESS_TOKEN=

# OCR 请求超时时间，单位秒。扫描件页数较多时建议保持较大值。
PPOCRV5_TIMEOUT_SECONDS=600

# 建议保持 true。服务支持时返回词/字符框，便于高亮证据定位。
PPOCRV5_RETURN_WORD_BOX=true


# ---------------------------------------------------------------------------
# PP-StructureV3 版面分析
# ---------------------------------------------------------------------------

# 必填。PP-Structure 服务 HTTP 地址。
PPSTRUCTURE_URL=http://10.8.7.76:8081/

# 可选。版面分析服务需要鉴权时填写访问 token。
PPSTRUCTURE_ACCESS_TOKEN=

# 版面分析请求超时时间，单位秒。
PPSTRUCTURE_TIMEOUT_SECONDS=600

# 建议保持 true。开启表格识别后，表格内容会进入表格比对而不是正文条款比对。
PPSTRUCTURE_USE_TABLE_RECOGNITION=true

# 合同包含印章/签章时建议保持 true。
PPSTRUCTURE_USE_SEAL_RECOGNITION=true

# 建议保持 true。用于识别页眉页脚、表格、印章、标题、图注等版面区域。
PPSTRUCTURE_USE_REGION_DETECTION=true

# P3 灰度开关：同一份文档的 PP-OCRv5 与 PP-Structure 请求并行执行。
HYBRID_COMPONENT_PARALLEL_ENABLED=false


# ---------------------------------------------------------------------------
# 文档语义清洗
# ---------------------------------------------------------------------------

# 开启确定性语义清洗，通过规则过滤明显的目录、签署页、表格、页眉页脚等非正文区域。
DOCUMENT_UNDERSTANDING_ENABLED=true


# ---------------------------------------------------------------------------
# 签署页视觉辅助
# ---------------------------------------------------------------------------

# 计划中的本地 OpenCV 视觉辅助后端，不依赖外部检测服务。
# 可选值：opencv、remote、local、off。签署视觉阶段集成后会消费该配置。
SIGNING_VISUAL_BACKEND=opencv

# 是否启用签署区视觉辅助。签署视觉阶段集成后，关闭它仍保留规则/OCR/版面结构识别。
SIGNING_VISUAL_ENABLED=true

# 计划中的 OpenCV 辅助检测红章、手写痕迹和候选页；集成后视觉单独命中只进入低置信候选。
SIGNING_OPENCV_DETECT_RED_SEAL=true
SIGNING_OPENCV_DETECT_HANDWRITING=true
SIGNING_OPENCV_SCAN_CANDIDATE_PAGES=true
SIGNING_OPENCV_MIN_CONFIDENCE=0.55
SIGNING_OPENCV_MAX_CANDIDATE_PAGES=6

# 后续只有 SIGNING_VISUAL_BACKEND=remote 时才配置远程视觉检测服务。
SIGNING_VISUAL_DETECTOR_URL=
SIGNING_VISUAL_DETECTOR_TIMEOUT=30

# 预留本地模型适配器；当前配置阶段不依赖该路径。
SIGNING_VISUAL_LOCAL_MODEL_PATH=


# ---------------------------------------------------------------------------
# 条款匹配
# ---------------------------------------------------------------------------

# 条款配对的基础相似度阈值。值越高，匹配越严格，但可能产生更多新增/删除。
MATCH_THRESHOLD=85

# 条款全局配对策略。
# greedy：保持历史贪心行为。
# optimal：使用稀疏二分图全局最优配对，适合重复模板条款和重排场景。
MATCH_ASSIGNMENT_STRATEGY=greedy

# 可选。部署了向量 embeddings 服务后再开启语义匹配。
MATCH_ENABLE_SEMANTIC_MATCH=false

# openai：使用 OpenAI-compatible /embeddings HTTP 接口。
# local：使用本地模型路径 MATCH_SEMANTIC_MODEL_PATH。
MATCH_SEMANTIC_PROVIDER=openai

# 向量服务基础地址，例如 http://embedding:8001/v1。
MATCH_SEMANTIC_BASE_URL=http://10.10.10.245:8000/v1/embeddings

# 可选。向量服务 API Key。
MATCH_SEMANTIC_API_KEY=sk-1234567890

# HTTP 向量服务的模型名称，例如 bge-m3 或 bge-small-zh-v1.5。
MATCH_SEMANTIC_MODEL=bge-m3

# 本地向量模型路径。仅 MATCH_SEMANTIC_PROVIDER=local 时使用。
MATCH_SEMANTIC_MODEL_PATH=

# OpenAI-compatible embedding 批次的最大并发数；返回结果仍按输入顺序合并。
MATCH_SEMANTIC_MAX_INFLIGHT=3

# 语义分在最终条款匹配分中的权重。建议先保持较保守的 0.08。
MATCH_SEMANTIC_WEIGHT=0.08

# sparse：仅当规则召回强候选不足时使用语义召回；always：每条原文均使用语义召回。
MATCH_SEMANTIC_RECALL_MODE=sparse

# sparse 模式下，强规则候选少于该数量时才触发语义召回。
MATCH_SEMANTIC_MIN_RULE_CANDIDATES=3

# 可选。私有化条款 rerank 服务，仅对已召回候选做精排。
MATCH_ENABLE_RERANK=false

# rerank 服务基础地址，例如 http://rerank:8002/v1。实际请求路径为 /rerank。
MATCH_RERANK_BASE_URL=http://127.0.0.1:8002/v1

# 可选。rerank 服务 API Key。
MATCH_RERANK_API_KEY=

# 可选。rerank 模型名称。
MATCH_RERANK_MODEL=contract-reranker

# 每条原文条款最多送入私有 rerank 服务的候选数。建议 20-50。
MATCH_RERANK_TOP_K=30

# 不同原文条款 rerank 请求的最大并发数；单任务内有界并发。
MATCH_RERANK_MAX_INFLIGHT=8

MATCH_RERANK_TIMEOUT_SECONDS=30
MATCH_RERANK_MAX_RETRIES=1

# rerank 分在最终条款匹配分中的权重。仅在私有化服务稳定后开启。
MATCH_RERANK_WEIGHT=0.12


# ---------------------------------------------------------------------------
# 报告与任务运行
# ---------------------------------------------------------------------------

# 可选。PDF 报告使用的中文字体路径；留空时使用系统默认字体。
REPORT_FONT_PATH=

# 后台任务并发数。只有在 OCR、版面分析、LLM 服务容量足够时再调大。
TASK_RUNNER_MAX_WORKERS=2
