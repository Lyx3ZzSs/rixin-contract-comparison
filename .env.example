# -----------------------------------------------------------------------------
# 运行时配置
# -----------------------------------------------------------------------------
# HOST=127.0.0.1                       # 服务监听地址
# PORT=8000                            # 服务监听端口
# RELOAD=true                          # 开发模式热重载
# STORAGE_DIR=storage                  # 文件存储根目录
# FRONTEND_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173  # 跨域允许来源

# -----------------------------------------------------------------------------
# 任务元数据存储
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# 上传限制
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=30                   # 合同比对 PDF 最大上传大小（MB）

# -----------------------------------------------------------------------------
# 合同比对文档提取
# -----------------------------------------------------------------------------
DOCUMENT_EXTRACTOR=auto                 # 通用/字段提取器，不控制合同比对严格链路
COMPARE_DOCUMENT_EXTRACTOR=ppstructure_ocr_hybrid  # 合同比对固定使用结构化 OCR
COMPARE_REQUIRE_STRUCTURED_OCR=true     # PP-Structure 失败时终止比对，不降级
PYMUPDF_MIN_TEXT_CHARS=1                # PyMuPDF 提取最少字符数（低于此值视为扫描件）
ALIGN_STRUCTURED_EXTRACTION=true        # 是否对结构化提取结果做对齐修正
SAVE_OCR_RAW_RESULT=true                # 是否保存 OCR 原始结果到 storage/ocr/

# -----------------------------------------------------------------------------
# PP-OCRv5 文字识别
# 用于扫描件 PDF 比对
# -----------------------------------------------------------------------------
#PPOCRV5_URL=http://10.8.7.76:8080/
PPOCRV5_URL=https://uu1013288-932c-985c9325.westb.seetacloud.com:8443/
# PPOCRV5_ACCESS_TOKEN=                # API 访问令牌（如需要）
PPOCRV5_TIMEOUT_SECONDS=600            # 请求超时时间（秒）
PPOCRV5_RETURN_WORD_BOX=true           # 是否返回单字级别坐标
PPOCRV5_USE_DOC_ORIENTATION_CLASSIFY=false  # 是否启用文档方向分类
PPOCRV5_USE_DOC_UNWARPING=false        # 是否启用文档去弯曲
PPOCRV5_USE_TEXTLINE_ORIENTATION=false  # 是否启用文本行方向分类
PPOCRV5_TEXT_REC_SCORE_THRESH=0.0      # 文本识别置信度阈值（低于此值过滤）
PPOCRV5_EDGE_NOISE_SCORE_THRESH=0.30   # 边缘噪声置信度阈值
PPOCRV5_EDGE_NOISE_MARGIN_RATIO=0.02   # 边缘噪声检测边距比例
PPOCRV5_EDGE_NOISE_MAX_CHARS=2         # 边缘噪声最大字符数

# -----------------------------------------------------------------------------
# PP-Structure 版面分析
# 用于默认结构化 OCR 比对路径
# -----------------------------------------------------------------------------
#PPSTRUCTURE_URL=http://10.8.7.76:8081/
PPSTRUCTURE_URL=https://u1013288-932c-985c9325.westb.seetacloud.com:8443/
# PPSTRUCTURE_ACCESS_TOKEN=            # API 访问令牌（如需要）
PPSTRUCTURE_TIMEOUT_SECONDS=600        # 请求超时时间（秒）
PPSTRUCTURE_USE_DOC_ORIENTATION_CLASSIFY=false  # 是否启用文档方向分类
PPSTRUCTURE_USE_DOC_UNWARPING=false    # 是否启用文档去弯曲
PPSTRUCTURE_USE_TEXTLINE_ORIENTATION=false  # 是否启用文本行方向分类
PPSTRUCTURE_USE_TABLE_RECOGNITION=true # 是否启用表格识别
PPSTRUCTURE_USE_SEAL_RECOGNITION=false # 是否启用印章识别
PPSTRUCTURE_USE_REGION_DETECTION=true  # 是否启用区域检测
PPSTRUCTURE_FORMAT_BLOCK_CONTENT=true  # 是否格式化块内容
LAYOUT_ANALYSIS_MODE=v2               # legacy | shadow | v2 | v3_shadow | v3

# -----------------------------------------------------------------------------
# 混合 OCR/版面合并
# 用于 hybrid 模式下合并 PP-OCRv5 与 PP-Structure 结果
# -----------------------------------------------------------------------------
HYBRID_LAYOUT_OVERLAP_THRESHOLD=0.5    # 版面框重叠判定阈值
HYBRID_LAYOUT_CENTER_FALLBACK=true     # 重叠不足时是否用中心点回退匹配
HYBRID_SAVE_MERGED_RAW=true            # 是否保存合并后的原始结果

# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# 差异匹配与报告
# -----------------------------------------------------------------------------
MATCH_THRESHOLD=85                     # 条款匹配相似度阈值（0-100）
# REPORT_FONT_PATH=                    # 报告 PDF 中文字体路径（留空自动检测）
