# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# HOST=127.0.0.1
# PORT=8000
# RELOAD=true
# FRONTEND_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# STORAGE_DIR=storage
# UPLOADS_DIR=
# TASKS_DIR=
# REPORTS_DIR=
# OCR_DIR=
# DEBUG_DIR=
# CACHE_DIR=

# -----------------------------------------------------------------------------
# Upload Limits
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=30

# -----------------------------------------------------------------------------
# Document Extraction
# -----------------------------------------------------------------------------
DOCUMENT_EXTRACTOR=auto
COMPARE_DOCUMENT_EXTRACTOR=ppstructure_ocr_hybrid
COMPARE_REQUIRE_STRUCTURED_OCR=true
PYMUPDF_MIN_TEXT_CHARS=1
ALIGN_STRUCTURED_EXTRACTION=true
SAVE_OCR_RAW_RESULT=true

# -----------------------------------------------------------------------------
# PP-OCRv5 Text Recognition
# -----------------------------------------------------------------------------
PPOCRV5_URL=http://127.0.0.1:8080
# PPOCRV5_ACCESS_TOKEN=
PPOCRV5_TIMEOUT_SECONDS=600
PPOCRV5_RETURN_WORD_BOX=true
PPOCRV5_USE_DOC_ORIENTATION_CLASSIFY=false
PPOCRV5_USE_DOC_UNWARPING=false
PPOCRV5_USE_TEXTLINE_ORIENTATION=false
PPOCRV5_TEXT_REC_SCORE_THRESH=0.0
PPOCRV5_EDGE_NOISE_SCORE_THRESH=0.30
PPOCRV5_EDGE_NOISE_MARGIN_RATIO=0.02
PPOCRV5_EDGE_NOISE_MAX_CHARS=2

# -----------------------------------------------------------------------------
# PP-Structure Layout Analysis
# -----------------------------------------------------------------------------
PPSTRUCTURE_URL=http://127.0.0.1:8081
# PPSTRUCTURE_ACCESS_TOKEN=
PPSTRUCTURE_TIMEOUT_SECONDS=600
PPSTRUCTURE_USE_DOC_ORIENTATION_CLASSIFY=false
PPSTRUCTURE_USE_DOC_UNWARPING=false
PPSTRUCTURE_USE_TEXTLINE_ORIENTATION=false
PPSTRUCTURE_USE_TABLE_RECOGNITION=true
PPSTRUCTURE_USE_SEAL_RECOGNITION=false
PPSTRUCTURE_USE_REGION_DETECTION=true
PPSTRUCTURE_FORMAT_BLOCK_CONTENT=true
LAYOUT_ANALYSIS_MODE=v2

# -----------------------------------------------------------------------------
# Hybrid OCR/Layout Merge
# -----------------------------------------------------------------------------
HYBRID_LAYOUT_OVERLAP_THRESHOLD=0.5
HYBRID_LAYOUT_CENTER_FALLBACK=true
HYBRID_SAVE_MERGED_RAW=true

# -----------------------------------------------------------------------------
# AI / LLM
# -----------------------------------------------------------------------------
# AI_LLM_BASE_URL=http://127.0.0.1:8002/v1
# AI_LLM_API_KEY=
# AI_LLM_MODEL=

# -----------------------------------------------------------------------------
# Clause Matching
# -----------------------------------------------------------------------------
MATCH_THRESHOLD=85
MATCH_USE_PREFILTER=true
MATCH_LOW_CONFIDENCE_REVIEW_THRESHOLD=78

# -----------------------------------------------------------------------------
# Semantic Embedding Matching
#
# MATCH_SEMANTIC_PROVIDER:
# - local: use a local sentence-transformers model from MATCH_SEMANTIC_MODEL_PATH
# - openai: call an OpenAI-compatible embeddings endpoint
# -----------------------------------------------------------------------------
MATCH_ENABLE_SEMANTIC_MATCH=false
MATCH_SEMANTIC_PROVIDER=local
MATCH_SEMANTIC_WEIGHT=0.08

# Local sentence-transformers provider
# MATCH_SEMANTIC_MODEL_PATH=/models/bge-small-zh-v1.5
MATCH_SEMANTIC_DEVICE=auto
MATCH_SEMANTIC_BATCH_SIZE=32

# OpenAI-compatible HTTP embeddings provider
# Request:  POST {MATCH_SEMANTIC_BASE_URL}/embeddings
# Body:     {"model":"...","input":["text1","text2"]}
# Response: {"data":[{"embedding":[0.1,0.2]}]}
# MATCH_SEMANTIC_BASE_URL=http://127.0.0.1:8001/v1
# MATCH_SEMANTIC_API_KEY=
# MATCH_SEMANTIC_MODEL=bge-small-zh-v1.5
MATCH_SEMANTIC_TIMEOUT_SECONDS=60
MATCH_SEMANTIC_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# Diff
# -----------------------------------------------------------------------------
DIFF_ENGINE=diff_match_patch

# -----------------------------------------------------------------------------
# Report
# -----------------------------------------------------------------------------
# REPORT_FONT_PATH=
# LIBREOFFICE_PATH=
LIBREOFFICE_HOST=127.0.0.1
LIBREOFFICE_PORT=2002
LIBREOFFICE_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Task Runner
# -----------------------------------------------------------------------------
TASK_RUNNER_MAX_WORKERS=2
TASK_RUNNER_MAX_ATTEMPTS=1
TASK_RUNNER_LEASE_SECONDS=3600
TASK_RUNNER_RETRY_DELAY_SECONDS=2.0
TASK_RUNNER_POLL_INTERVAL_SECONDS=0.25

# -----------------------------------------------------------------------------
# Model Registry
# -----------------------------------------------------------------------------
MODEL_REGISTRY_MAX_LOADED=0
# MODEL_REGISTRY_PRELOAD=
