# 后端环境变量示例。
# 本地部署时请复制为 backend/.env 使用，不要提交真实 .env 文件。
# 结构化合同比对必配：PPOCRV5_URL 和 PPSTRUCTURE_URL。
# 可选增强能力：文档语义清洗 LLM、向量语义匹配。


# ---------------------------------------------------------------------------
# 基础运行
# ---------------------------------------------------------------------------

# 运行时存储根目录。相对路径会按仓库根目录解析。
STORAGE_DIR=storage

# PDF 上传大小上限，单位 MB。
MAX_UPLOAD_SIZE_MB=30


# ---------------------------------------------------------------------------
# 结构化抽取
# ---------------------------------------------------------------------------

# 推荐的合同比对抽取器：合并 PP-Structure 版面结果和 PP-OCRV5 文本结果。
COMPARE_DOCUMENT_EXTRACTOR=ppstructure_ocr_hybrid

# 生产环境建议保持 true；结构化 OCR 不可用时直接失败，避免退化为低质量比对。
COMPARE_REQUIRE_STRUCTURED_OCR=true

# 使用 v3 版面流角色，用于识别正文、页眉页脚、表格、噪声等区域。
LAYOUT_ANALYSIS_MODE=v3


# ---------------------------------------------------------------------------
# PP-OCRV5 文本识别
# ---------------------------------------------------------------------------

# 必填。PP-OCRV5 服务 HTTP 地址。
PPOCRV5_URL=http://127.0.0.1:8866

# 可选。OCR 服务需要鉴权时填写访问 token。
PPOCRV5_ACCESS_TOKEN=

# OCR 请求超时时间，单位秒。扫描件页数较多时建议保持较大值。
PPOCRV5_TIMEOUT_SECONDS=600

# 建议保持 true。服务支持时返回词/字符框，便于高亮证据定位。
PPOCRV5_RETURN_WORD_BOX=true


# ---------------------------------------------------------------------------
# PP-StructureV3 版面分析
# ---------------------------------------------------------------------------

# 必填。PP-Structure 服务 HTTP 地址。
PPSTRUCTURE_URL=http://127.0.0.1:8867

# 可选。版面分析服务需要鉴权时填写访问 token。
PPSTRUCTURE_ACCESS_TOKEN=

# 版面分析请求超时时间，单位秒。
PPSTRUCTURE_TIMEOUT_SECONDS=600

# 建议保持 true。开启表格识别后，表格内容会进入表格比对而不是正文条款比对。
PPSTRUCTURE_USE_TABLE_RECOGNITION=true

# 合同包含印章/签章时建议保持 true。
PPSTRUCTURE_USE_SEAL_RECOGNITION=true

# 建议保持 true。用于识别页眉页脚、表格、印章、标题、图注等版面区域。
PPSTRUCTURE_USE_REGION_DETECTION=true


# ---------------------------------------------------------------------------
# 文档语义清洗
# ---------------------------------------------------------------------------

# 开启确定性语义清洗。即使不启用 LLM，也会通过规则过滤明显的目录、签署页、
# 表格、页眉页脚等非正文区域。
DOCUMENT_UNDERSTANDING_ENABLED=true

# 可选。只有在部署了 OpenAI-compatible chat-completions 服务时才开启。
DOCUMENT_UNDERSTANDING_LLM_ENABLED=false

# LLM 服务基础地址，例如 http://llm:8000/v1。
DOCUMENT_UNDERSTANDING_LLM_BASE_URL=

# 可选。LLM 服务 API Key。
DOCUMENT_UNDERSTANDING_LLM_API_KEY=

# 用于页面/块语义清洗的聊天模型，例如 qwen2.5-72b-instruct。
DOCUMENT_UNDERSTANDING_LLM_MODEL=

# LLM 请求超时时间和最大重试次数。
DOCUMENT_UNDERSTANDING_LLM_TIMEOUT_SECONDS=60
DOCUMENT_UNDERSTANDING_LLM_MAX_RETRIES=2

# 默认保持 false。OCR 纠错对合同比对风险较高，因为金额、日期、公司名称、
# 合同编号等必须可追溯到原始文本。
DOCUMENT_UNDERSTANDING_ENABLE_OCR_CORRECTION=false

# 启用 LLM 后，允许相邻页面窗口给出跨页条款合并建议。
DOCUMENT_UNDERSTANDING_ENABLE_CROSS_PAGE_MERGE=true


# ---------------------------------------------------------------------------
# 条款匹配
# ---------------------------------------------------------------------------

# 条款配对的基础相似度阈值。值越高，匹配越严格，但可能产生更多新增/删除。
MATCH_THRESHOLD=85

# 条款全局配对策略。
# greedy：保持历史贪心行为。
# optimal：使用稀疏二分图全局最优配对，适合重复模板条款和重排场景。
MATCH_ASSIGNMENT_STRATEGY=greedy

# 可选。部署了向量 embeddings 服务后再开启语义匹配。
MATCH_ENABLE_SEMANTIC_MATCH=false

# openai：使用 OpenAI-compatible /embeddings HTTP 接口。
# local：使用本地模型路径 MATCH_SEMANTIC_MODEL_PATH。
MATCH_SEMANTIC_PROVIDER=openai

# 向量服务基础地址，例如 http://embedding:8001/v1。
MATCH_SEMANTIC_BASE_URL=http://127.0.0.1:8001/v1

# 可选。向量服务 API Key。
MATCH_SEMANTIC_API_KEY=

# HTTP 向量服务的模型名称，例如 bge-m3 或 bge-small-zh-v1.5。
MATCH_SEMANTIC_MODEL=bge-small-zh-v1.5

# 本地向量模型路径。仅 MATCH_SEMANTIC_PROVIDER=local 时使用。
MATCH_SEMANTIC_MODEL_PATH=

# 语义分在最终条款匹配分中的权重。建议先保持较保守的 0.08。
MATCH_SEMANTIC_WEIGHT=0.08

# 可选。私有化条款 rerank 服务，仅对已召回候选做精排。
MATCH_ENABLE_RERANK=false

# rerank 服务基础地址，例如 http://rerank:8002/v1。实际请求路径为 /rerank。
MATCH_RERANK_BASE_URL=http://127.0.0.1:8002/v1

# 可选。rerank 服务 API Key。
MATCH_RERANK_API_KEY=

# 可选。rerank 模型名称。
MATCH_RERANK_MODEL=contract-reranker

# 每条原文条款最多送入私有 rerank 服务的候选数。建议 20-50。
MATCH_RERANK_TOP_K=30

MATCH_RERANK_TIMEOUT_SECONDS=30
MATCH_RERANK_MAX_RETRIES=1

# rerank 分在最终条款匹配分中的权重。仅在私有化服务稳定后开启。
MATCH_RERANK_WEIGHT=0.12


# ---------------------------------------------------------------------------
# 报告与运行参数
# ---------------------------------------------------------------------------

# 可选。PDF 报告使用的中文字体路径；留空时使用系统默认字体。
REPORT_FONT_PATH=

# 后台任务并发数。只有在 OCR、版面分析、LLM 服务容量足够时再调大。
TASK_RUNNER_MAX_WORKERS=2
