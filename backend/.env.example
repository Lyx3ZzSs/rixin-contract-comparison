# 后端环境变量示例。
# 本地部署时请复制为 backend/.env 使用，不要提交真实 .env 文件。
# 结构化合同比对必配：PPOCRV5_URL 和 PPDOCLAYOUT_ENDPOINT。
# 可选增强能力：向量语义匹配。


# ---------------------------------------------------------------------------
# 基础运行
# ---------------------------------------------------------------------------

# 运行时存储根目录。相对路径会按仓库根目录解析。
STORAGE_DIR=storage

# PDF 上传大小上限，单位 MB。
MAX_UPLOAD_SIZE_MB=30


# ---------------------------------------------------------------------------
# 结构化抽取
# ---------------------------------------------------------------------------

# 合同比对使用 Native-first、PP-DocLayoutV3 和选择性 PP-OCRv6。


# P1 灰度开关。仅在 OCR 服务两路并发压测通过后开启。
COMPARE_PARALLEL_EXTRACTION_ENABLED=false

# 单个 API 进程同时执行的文档解析数，避免多个后台任务把 OCR 服务并发放大。
COMPARE_PARALLEL_EXTRACTION_MAX_INFLIGHT=2

# 页脚视觉差异识别的页面级最大并发数；结果仍按页码顺序合并。
COMPARE_FOOTER_VISUAL_MAX_INFLIGHT=4


# 缓存仅在本次任务内复用；页面缓存设为 0、匹配特征缓存设为 false 可关闭。
COMPARE_PAGE_ALIGNMENT_CACHE_SIZE=50000
COMPARE_PAGE_RENDER_CACHE_MB=64
# 仅并行独立页面的 OpenCV 分析；PDF 读取保持串行。设为 1 可回退串行分析。
COMPARE_IMAGE_ANALYSIS_MAX_INFLIGHT=2
# 包含条款路径、页关系和向量相似度复用；不减少候选或模型请求。
MATCH_FEATURE_CACHE_ENABLED=true

# 默认开启严格精确对应的匹配加速；设为 off 可回退，shadow 仅记录诊断。
MATCH_PERFORMANCE_STRATEGY=enabled
# 模型输入去重仍处于试验阶段，默认关闭。
MATCH_DEDUPLICATE_MODEL_INPUTS=false




# ---------------------------------------------------------------------------
# PP-OCRV5 文本识别
# ---------------------------------------------------------------------------

# 必填。PP-OCRV5 服务 HTTP 地址。
PPOCRV5_URL=http://127.0.0.1:8866

# 可选。OCR 服务需要鉴权时填写访问 token。
PPOCRV5_ACCESS_TOKEN=

# OCR 请求超时时间，单位秒。扫描件页数较多时建议保持较大值。
PPOCRV5_TIMEOUT_SECONDS=600

# 建议保持 true。服务支持时返回词/字符框，便于高亮证据定位。
PPOCRV5_RETURN_WORD_BOX=true


# ---------------------------------------------------------------------------
# PP-DocLayoutV3 单页版面识别。生产请求固定 dynamicBatch=false / batch_size=1。
# ---------------------------------------------------------------------------
PPDOCLAYOUT_ENDPOINT=http://10.10.12.64:8090/layout-detection
PPDOCLAYOUT_TIMEOUT=120
PPDOCLAYOUT_MAX_INFLIGHT=4
PPDOCLAYOUT_TITLE_THRESHOLD=0.4
PPDOCLAYOUT_DEFAULT_THRESHOLD=0.5
PPDOCLAYOUT_NMS=false


# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 文档语义清洗
# ---------------------------------------------------------------------------

# 开启确定性语义清洗，通过规则过滤明显的目录、签署页、表格、页眉页脚等非正文区域。
DOCUMENT_UNDERSTANDING_ENABLED=true


# ---------------------------------------------------------------------------
# 条款匹配
# ---------------------------------------------------------------------------

# 条款配对的基础相似度阈值。值越高，匹配越严格，但可能产生更多新增/删除。
MATCH_THRESHOLD=85

# 条款全局配对策略。
# greedy：保持历史贪心行为。
# optimal：使用稀疏二分图全局最优配对，适合重复模板条款和重排场景。
MATCH_ASSIGNMENT_STRATEGY=greedy

# 可选。部署了向量 embeddings 服务后再开启语义匹配。
MATCH_ENABLE_SEMANTIC_MATCH=false

# openai：使用 OpenAI-compatible /embeddings HTTP 接口。
# local：使用本地模型路径 MATCH_SEMANTIC_MODEL_PATH。
MATCH_SEMANTIC_PROVIDER=openai

# 向量服务基础地址，例如 http://embedding:8001/v1。
MATCH_SEMANTIC_BASE_URL=http://127.0.0.1:8001/v1

# 可选。向量服务 API Key。
MATCH_SEMANTIC_API_KEY=

# HTTP 向量服务的模型名称，例如 bge-m3 或 bge-small-zh-v1.5。
MATCH_SEMANTIC_MODEL=bge-small-zh-v1.5

# 本地向量模型路径。仅 MATCH_SEMANTIC_PROVIDER=local 时使用。
MATCH_SEMANTIC_MODEL_PATH=

# OpenAI-compatible embedding 批次的最大并发数；返回结果仍按输入顺序合并。
MATCH_SEMANTIC_MAX_INFLIGHT=3

# 语义分在最终条款匹配分中的权重。建议先保持较保守的 0.08。
MATCH_SEMANTIC_WEIGHT=0.08

# sparse：仅当规则召回强候选不足时使用语义召回；always：每条原文均使用语义召回。
MATCH_SEMANTIC_RECALL_MODE=sparse

# sparse 模式下，强规则候选少于该数量时才触发语义召回。
MATCH_SEMANTIC_MIN_RULE_CANDIDATES=3

# 可选。私有化条款 rerank 服务，仅对已召回候选做精排。
MATCH_ENABLE_RERANK=false

# rerank 服务基础地址，例如 http://rerank:8002/v1。实际请求路径为 /rerank。
MATCH_RERANK_BASE_URL=http://127.0.0.1:8002/v1

# 可选。rerank 服务 API Key。
MATCH_RERANK_API_KEY=

# 可选。rerank 模型名称。
MATCH_RERANK_MODEL=contract-reranker

# 每条原文条款最多送入私有 rerank 服务的候选数。建议 20-50。
MATCH_RERANK_TOP_K=30

# 不同原文条款 rerank 请求的最大并发数；单任务内有界并发。
MATCH_RERANK_MAX_INFLIGHT=8

MATCH_RERANK_TIMEOUT_SECONDS=30
MATCH_RERANK_MAX_RETRIES=1

# rerank 分在最终条款匹配分中的权重。仅在私有化服务稳定后开启。
MATCH_RERANK_WEIGHT=0.12


# ---------------------------------------------------------------------------
# 报告与运行参数
# ---------------------------------------------------------------------------

# 可选。PDF 报告使用的中文字体路径；留空时使用系统默认字体。
REPORT_FONT_PATH=

# 后台任务并发数。只有在 OCR、版面分析、LLM 服务容量足够时再调大。
TASK_RUNNER_MAX_WORKERS=2

# Optional CPU table service. Start in shadow; enable branches after validation.
TABLE_STRUCTURE_MODE=shadow
TABLE_STRUCTURE_ENDPOINT=http://127.0.0.1:8091
TABLE_STRUCTURE_TIMEOUT=30
TABLE_STRUCTURE_MAX_INFLIGHT=1
TABLE_STRUCTURE_WIRED_ENABLED=true
TABLE_STRUCTURE_WIRELESS_ENABLED=false
TABLE_STRUCTURE_ALTERNATE_ENABLED=true

# Optional OCR recognition-only table orientation service; default off.
TABLE_ORIENTATION_MODE=enabled
TABLE_ORIENTATION_ENDPOINT=http://127.0.0.1:8092
TABLE_ORIENTATION_TIMEOUT=10
TABLE_ORIENTATION_DOCUMENT_BUDGET=30
TABLE_ORIENTATION_MIN_SCORE=0.85
TABLE_ORIENTATION_MARGIN=0.08
