# Backend API base URL used by the Vite frontend during local development.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Public Keycloak OIDC SPA configuration. Do not add a Client Secret here.
VITE_OIDC_AUTHORITY=http://10.8.6.32:18080/realms/company-dev
VITE_OIDC_CLIENT_ID=rixin-contract-comparison-web
VITE_OIDC_REDIRECT_URI=http://127.0.0.1:5173/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:5173/
VITE_OIDC_SCOPE=openid profile email

# Docker 部署说明：
# - Docker 构建时会将此值设为空字符串 (VITE_API_BASE_URL=)，前端 API 走同域 Nginx 反向代理。
# - 本地开发时保持 http://127.0.0.1:8000 即可直连后端。
