# Frontend Dockerfile — Multi-stage: Node.js build → Nginx serve

# Stage 1: Build
FROM node:20-alpine AS builder
WORKDIR /build

# Set VITE_API_BASE_URL to empty string so the frontend uses
# same-origin requests (Nginx proxies /api/ → backend container).
ARG VITE_BASE_PATH=/
ARG VITE_API_BASE_PATH=
ARG VITE_API_BASE_URL=
ARG VITE_AUTH_MODE=oidc
ARG VITE_AUTH_DISABLED_USER_SUB=local-dev
ARG VITE_AUTH_DISABLED_USER_NAME=本地开发用户
ARG VITE_AUTH_DISABLED_USER_ROLES=agent_admin,agent_manager,agent_user
ARG VITE_OIDC_AUTHORITY=
ARG VITE_OIDC_CLIENT_ID=
ARG VITE_OIDC_REDIRECT_URI=
ARG VITE_OIDC_POST_LOGOUT_REDIRECT_URI=
ARG VITE_OIDC_SCOPE=

ENV VITE_BASE_PATH=$VITE_BASE_PATH
ENV VITE_API_BASE_PATH=$VITE_API_BASE_PATH
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_AUTH_MODE=$VITE_AUTH_MODE
ENV VITE_AUTH_DISABLED_USER_SUB=$VITE_AUTH_DISABLED_USER_SUB
ENV VITE_AUTH_DISABLED_USER_NAME=$VITE_AUTH_DISABLED_USER_NAME
ENV VITE_AUTH_DISABLED_USER_ROLES=$VITE_AUTH_DISABLED_USER_ROLES
ENV VITE_OIDC_AUTHORITY=$VITE_OIDC_AUTHORITY
ENV VITE_OIDC_CLIENT_ID=$VITE_OIDC_CLIENT_ID
ENV VITE_OIDC_REDIRECT_URI=$VITE_OIDC_REDIRECT_URI
ENV VITE_OIDC_POST_LOGOUT_REDIRECT_URI=$VITE_OIDC_POST_LOGOUT_REDIRECT_URI
ENV VITE_OIDC_SCOPE=$VITE_OIDC_SCOPE

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# Stage 2: Serve
FROM nginx:1.27-alpine

# Replace default config with our custom one
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built frontend assets
COPY --from=builder /build/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -q -O - http://127.0.0.1:8080/ > /dev/null || exit 1
